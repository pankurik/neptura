# Shopify Storefront API (Dev Dashboard app — catalog, cart, checkout)
# For contact phone on /account, also add Admin API scopes on this app:
#   read_customers, write_customers → Release → reinstall on store
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret

# Optional: reuse a fixed Storefront token (recommended for local dev).
# SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token

# Customer Account API (Headless channel → Customer Account API settings — login/signup)
# Separate from Storefront credentials above. Confidential client required.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
SHOPIFY_CUSTOMER_ACCOUNT_SHOP_ID=

# Public app URL for OAuth callbacks — must be HTTPS (use ngrok for local dev)
# In Headless → Customer Account API settings, also register:
#   Callback URL: {NEXT_PUBLIC_APP_URL}/api/auth/callback
#   Logout URI:   {NEXT_PUBLIC_APP_URL}/login
#                 {NEXT_PUBLIC_APP_URL}/  (optional)
NEXT_PUBLIC_APP_URL=https://your-subdomain.ngrok-free.app
